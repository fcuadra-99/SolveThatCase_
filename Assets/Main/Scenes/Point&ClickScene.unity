  m_Script: {fileID: 11500000, guid: 6d16b1193267acd4d8c3f109a25dc35e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  buttonContainer: {fileID: 2110887493}
  nameText: {fileID: 1646661519}
  descriptionText: {fileID: 1379274283}
  itemButtonPrefab: {fileID: 2809741602295087615, guid: e347e1899e68d82478a9fdfbb46c6cb3, type: 3}
  itemDatabase:
  - itemName: Drink w/ Note
    description: A cocktail glass with an oily residue on the rim. It emits a strong,
      artificial scent of bitter almonds. And under the drink, a small, elegant card
      with a handwritten recipe for "The Lumen Gold." The recipe specifically calls
      for Kiwano Melon as both juice and garnish
    dialogueEvents:
    - characterName: Rutil
      dialogueText: 'A drink.. with a note under it.

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Cassian
      dialogueText: It has the classic scent of cyanide. But look at the oily residue
        on the rim. It's... thick. Almost like an essential oil.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 188772289}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: ' '
      dialogueText: (A cocktail glass with an oily residue on the rim. It emits a
        strong, artificial scent of bitter almonds.)
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 0}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: ' '
      dialogueText: (And under the drink, a small, elegant card with a handwritten
        recipe for "The Lumen Gold." The recipe specifically calls for Kiwano Melon
        as both juice and garnish.)
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 0}
      delay: 0
      jumpIndex: -2
      choices: []
    worldLocation: {fileID: 1815360955}
  - itemName: Garnish Tray
    description: A tray of cocktail garnishes. Contains standard items, but also
      slices of an exotic 'Kiwano Melon,' noted by Leigh as a special request from
      Maddison.
    dialogueEvents:
    - characterName: ' '
      dialogueText: Rutil moves behind the bar. He examines the bartender's station.
        A stainless-steel tray holds cut lemons, olives, and asks the bartender.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 0}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Leigh
      dialogueText: 'It''s a Kiwano melon. She... she requested it. It got delivered
        just today.

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 894287887}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Rutil
      dialogueText: It looks exotic. And the oil from its rind... I'll bet that's
        the source of the almond smell.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: ' '
      dialogueText: (A tray of cocktail garnishes. Contains standard items, but also
        slices of an exotic 'Kiwano Melon,' noted by Leigh as a special request from
        Maddison.)
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 0}
      delay: 0
      jumpIndex: -1
      choices: []
    worldLocation: {fileID: 19434687}
  - itemName: Receipt
    description: A receipt for a rush order of Kiwano Melons, delivered to the bar
      today. It was signed for by "M.V." The handwriting matches the Recipe Card.
    dialogueEvents:
    - characterName: ' '
      dialogueText: (A receipt for a rush order of Kiwano Melons, delivered to the
        bar today. It was signed for by "M.V." The handwriting matches the Recipe
        Card.)
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 0}
      delay: 0
      jumpIndex: -2
      choices: []
    worldLocation: {fileID: 1339164785}
  - itemName: Epipen
    description: An auto-injector for severe allergic reactions, found discarded
      outside the bar. It is a spare, not the one she would have used if she had
      a reaction, raising questions about her actions.
    dialogueEvents:
    - characterName: ' '
      dialogueText: (An auto-injector for severe allergic reactions, found discarded
        outside the bar. It is a spare, not the one she would have used if she had
        a reaction, raising questions about her actions.)
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 0}
      delay: 0
      jumpIndex: -2
      choices: []
    worldLocation: {fileID: 655938938}
