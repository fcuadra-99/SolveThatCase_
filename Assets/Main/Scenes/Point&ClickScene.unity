--- !u!114 &132475607
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 132475605}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a33af7230a07bd844b4efbc9a0a9894a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogManager: {fileID: 757171599}
  spotlightControl: {fileID: 1363181443}
  fileCollection: {fileID: 700861316}
  profileCollection: {fileID: 755518603}
  uiControl: {fileID: 1192382096}
  presentEvidenceButton: {fileID: 476506406}
  presentProfileButton: {fileID: 1066188617}
  phases:
  - testimonyEvents:
    - characterName: Valentina
      dialogueText: The investigation is OVER! The "Crime Time LIVE" trial... begins!
        Leigh, you stand accused of the attempted murder of Maddison Vane! Mr. Rutil,
        you seem to have taken the lead. The floor is yours.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 568991861}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Leigh
      dialogueText: 'I... I''ll say it again! I just made the drink!

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 894287887}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Valentina
      dialogueText: Your testimony, please!
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 568991861}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Valentina
      dialogueText: Your testimony, please!
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 568991861}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Leigh (Testimony)
      dialogueText: I'm a beginner but. I would never, ever harm a customer.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 894287887}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Leigh (Testimony)
      dialogueText: Maddison came in and ordered a drink I'd never heard of.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 894287887}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Leigh (Testimony)
      dialogueText: She gave me a specific recipe on a card, and I followed it exactly.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 894287887}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Leigh (Testimony)
      dialogueText: I used the ingredients she requested, even the weird fruit.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 894287887}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Leigh (Testimony)
      dialogueText: I served it to her, and that's it! I never touched it again!
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 894287887}
      delay: 0
      jumpIndex: 4
      choices: []
    correctIndex: 6
    requiredEvidence: Drink w/ Note
    logicPointsGain: 10
    logicPointsPenalty: 10
    correctEvidenceDialogue:
    - characterName: Rutil
      dialogueText: 'Leigh, you said you followed the recipe exactly on this note?

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Rutil
      dialogueText: Yes! To the letter!
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    wrongEvidenceDialogue:
    - characterName: Rutil
      dialogueText: (Thats wrong. I need to rethink for a bit.)
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
  - testimonyEvents:
    - characterName: Valentina
      dialogueText: 'Maddison, my dear! Tell the audience what happened!

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 568991861}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Maddison (Testimony)
      dialogueText: I came in for my usual, a simple gin and tonic.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1163179867}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Maddison (Testimony)
      dialogueText: Leigh... she... she insisted I try a 'new special' he'd made.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1163179867}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Maddison (Testimony)
      dialogueText: She gave me the drink. It... it smelled strange. Like almonds
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1163179867}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Maddison (Testimony)
      dialogueText: I took one sip, and my throat started to close! I couldn't breathe!
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1163179867}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Maddison (Testimony)
      dialogueText: It was poison! She tried to kill me!
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1163179867}
      delay: 0
      jumpIndex: 1
      choices: []
    correctIndex: 1
    requiredEvidence: Drink w/ Note
    logicPointsGain: 10
    logicPointsPenalty: 10
    correctEvidenceDialogue:
    - characterName: Rutil
      dialogueText: That's a lie, isn't it?
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Maddison
      dialogueText: 'What? No!

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1163179867}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Rutil
      dialogueText: '(Shows the note) This is your handwriting, isn''t it? You didn''t
        order your "usual." You brought in this custom recipe for "The Lumen Gold"
        and demanded Leigh make it!

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Maddison
      dialogueText: 'I... I... well, yes! I wanted to try something new! That doesn''t
        mean...

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Rutil
      dialogueText: She never insisted on a new recipe, you heard Leigh's testimony
        already.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Rutil
      dialogueText: "The \"poison.\" Let's talk about that.\r"
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    wrongEvidenceDialogue:
    - characterName: Rutil
      dialogueText: No thats wrong, think again.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
  - testimonyEvents:
    - characterName: Rutil
      dialogueText: It smelled strange. Like almonds.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Elena
      dialogueText: It certainly did. But where did that smell come from?
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 961838713}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Cassian
      dialogueText: The poison! Cyanide!
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 188772289}
      delay: 0
      jumpIndex: 0
      choices: []
    correctIndex: 2
    requiredEvidence: Garnish Tray
    logicPointsGain: 10
    logicPointsPenalty: 10
    correctEvidenceDialogue:
    - characterName: Rutil
      dialogueText: he smell wasn't from poison! It was from the aromatic oil on
        the rind of this... the Kiwano Melon! The exact garnish you specifically
        requested on your recipe card.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Maddison
      dialogueText: That... that's a coincidence! The fruit... it...
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1163179867}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Rutil
      dialogueText: 'Is it? Why this fruit? Why a fruit so rare you couldn''t be
        sure the bar would have it?

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Rutil
      dialogueText: 'This delivery slip shows it, you don''t just "like" it. You
        ordered it! You had a box of Kiwano Melons rush-delivered to the bar yourself
        today, and signed for it with your own initials!

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    wrongEvidenceDialogue:
    - characterName: Rutil
      dialogueText: No thats wrong, think again.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
  - testimonyEvents:
    - characterName: Rutil
      dialogueText: 'Let''s go to your previous statement.

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Rutil
      dialogueText: '"I took one sip, and my throat started to close! I couldn''t
        breathe!"'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Rutil
      dialogueText: ' I believe you. I believe your throat did feel tight. I believe
        you had an allergic reaction.

'
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: 0
      choices: []
    - characterName: Maddison
      dialogueText: Yes! Yes, exactly! I... wait...
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1163179867}
      delay: 0
      jumpIndex: 0
      choices: []
    correctIndex: 3
    requiredEvidence: Epipen
    logicPointsGain: 10
    logicPointsPenalty: 10
    correctEvidenceDialogue:
    - characterName: Rutil
      dialogueText: Do you have an allergy to exotic fruits. You carry these for
        emergencies. You even had a spare [Unused EpiPen] discarded outside, implying
        you'd used another earlier. Why hide the spare? Why not openly seek medical
        attention if you were truly poisoned and near death? You knew it wasn't poison,
        Maddison. You knew it was an allergy. And you knew it would be a dramatic
        show, but not deadly. You didn't panic. You performed.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
    - characterName: Maddison
      dialogueText: Do you have an allergy to exotic fruits. You carry these for
        emergencies. You even had a spare [Unused EpiPen] discarded outside, implying
        you'd used another earlier. Why hide the spare? Why not openly seek medical
        attention if you were truly poisoned and near death? You knew it wasn't poison,
        Maddison. You knew it was an allergy. And you knew it would be a dramatic
        show, but not deadly. You didn't panic. You performed.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1163179867}
      delay: 0
      jumpIndex: -1
      choices: []
    wrongEvidenceDialogue:
    - characterName: Rutil
      dialogueText: No thats wrong, think again.
      voiceLine: {fileID: 0}
      typingSFX: {fileID: 0}
      activeChar: {fileID: 1350676010}
      delay: 0
      jumpIndex: -1
      choices: []
  finalDialogue:
  - characterName: Valentina
    dialogueText: 'Rutil... explain. What really happened here tonight?

'
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 568991861}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: 'There was no poison. There was no attempted murder. There was
      only a performance, staged for the benefit of these cameras.

'
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: 'Maddison has a personal  grudge against this establishment. Her
      family lost a major bid to purchase this property to the current owners last
      year. Her motive wasn''t simply to generate a headline; it was to force a permanent
      closure. '
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: 'She knew the immediate scandal of a high-profile poisoning would
      trigger a license investigation and a catastrophic health hazard shutdown.
      She used this television show, Crime Time LIVE, not for the prize, but as a
      guaranteed, highly public platform to ensure the destruction of Lumen Alley.
      She wanted the cameras here to document the "crime" and secure the death sentence
      for the business. '
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: First, she needed her 'poison.' So she chose an allergen... the
      [Delivery Slip] proves she ordered the Kiwano Melons on her behalf, being in
      charge with the bar's supplies.
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: Second, she had to get it into her drink. She wrote this [Recipe
      Card] to force Leigh to use her specific ingredient, making the bar directly
      responsible for serving the allergen.
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: Third, she needed to be 'safe.' She has a known, mild allergy.
      But just in case, she had her EpiPen ready and even a spare [Unused EpiPen]
      she discarded outside. She knew she'd have a reaction, but she also knew she
      wouldn't die. The brief choking fit was merely the setup for the ensuing panic
      and the subsequent legal action she planned to file.
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: But an allergy isn't 'poison.' She needed to frame Leigh and make
      the narrative truly sensational. So she created the smell of poison.
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: ' '
    dialogueText: 'Rutil walks to the bar. He picks up the [Second Glass]... the
      one she actually drank from.

'
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 0}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: 'This is the glass she drank from. The one with the Kiwano juice
      inside. She drank it, felt the mild allergic reaction, and started her show.

'
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: ...and this is the prop. The 'poisoned' glass. While everyone was
      panicking, she swapped them, leaving this one for us to find. How do I know?
      Because she rubbed the oil from the Kiwano rind all over the rim. An oil that
      just so happens to smell... like bitter almonds. The classic, theatrical calling
      card of cyanide, perfectly chosen to guarantee the bar would lose its license
      immediately.
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices:
    - choiceText: (Drink Maddison's Glass)
      jumpIndex: -1
      meterAdjustment: 50
  - characterName: Maddison
    dialogueText: YOU'RE INSANE! IT'S POISON! DRINK IT! I DARE YOU! DRINK IT AND
      DIE IF YOU'RE SO SURE!
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1163179867}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: ' '
    dialogueText: 'The room holds its breath. Elena watches, a flicker of approval
      in her eyes. '
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 0}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Leigh
    dialogueText: 'Don''t! '
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 894287887}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: ' '
    dialogueText: Rutil takes a long, slow drink, and swallows.
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 894287887}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Rutil
    dialogueText: 'It''s... a bit fruity. A little oily on the rim. But definitely...
      not poison. I''m not allergic, Maddison. But you are. The case is closed. The
      scandal you sought will only lead to your arrest for fraud and conspiracy.



'
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 1350676010}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: ' '
    dialogueText: Maddison lets out a guttural sob. It's not a performance this time.
      It's the raw, ugly sound of defeat.
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 0}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: ' '
    dialogueText: 'Valentina''s eyes are wide. She turns to the camera, her smile
      brighter than ever.

'
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 0}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: Valentine
    dialogueText: You've seen it here, folks! An incredible, shocking reveal! The
      victim... was the culprit! Her goal? To destroy a rival business! Join us next
      week for another "Crime Time LIVE"!
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 568991861}
    delay: 0
    jumpIndex: -1
    choices: []
  - characterName: ' '
    dialogueText: The cameras switch off. Cassian sulks, robbed of his moment. Elena
      gives Rutil a single, respectful nod.
    voiceLine: {fileID: 0}
    typingSFX: {fileID: 0}
    activeChar: {fileID: 0}
    delay: 0
    jumpIndex: -1
    choices: []
